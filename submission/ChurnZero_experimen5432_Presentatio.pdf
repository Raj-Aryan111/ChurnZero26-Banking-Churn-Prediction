      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "X Shape      : (8101, 92)\n",
            "X_test Shape : (2026, 92)\n",
            "Categorical Columns : 15\n",
            "Numerical Columns   : 77\n",
            "Scale Pos Weight    : 5.22\n",
            "\n",
            "Leakage-debug dataset prepared successfully\n"
          ]
        }
      ]
