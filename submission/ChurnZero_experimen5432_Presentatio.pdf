          ]
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0:\tlearn: 0.9760695\ttest: 0.9759516\tbest: 0.9759516 (0)\ttotal: 47.6ms\tremaining: 47.5s\n",
            "100:\tlearn: 1.0000000\ttest: 0.9999801\tbest: 0.9999801 (92)\ttotal: 7.63s\tremaining: 1m 7s\n",
            "200:\tlearn: 1.0000000\ttest: 0.9999887\tbest: 0.9999943 (179)\ttotal: 12.1s\tremaining: 48.2s\n",
            "bestTest = 0.9999943318\n",
            "bestIteration = 179\n",
            "Shrink model to first 180 iterations.\n",
            "Fold 4 | PR-AUC = 1.0000 | ROC-AUC = 1.0000 | Iters = 179\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "Default metric period is 5 because PRAUC is/are not implemented for GPU\n",
            "Metric PRAUC is not implemented on GPU. Will use CPU for metric computation, this could significantly affect learning time\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0:\tlearn: 0.9764573\ttest: 0.9717601\tbest: 0.9717601 (0)\ttotal: 46.6ms\tremaining: 46.6s\n",
            "100:\tlearn: 1.0000000\ttest: 0.9999944\tbest: 0.9999972 (93)\ttotal: 6.57s\tremaining: 58.4s\n",
            "bestTest = 0.9999971855\n",
            "bestIteration = 93\n",
            "Shrink model to first 94 iterations.\n",
            "Fold 5 | PR-AUC = 1.0000 | ROC-AUC = 1.0000 | Iters = 93\n",
            "\n",
