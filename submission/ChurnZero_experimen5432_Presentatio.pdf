            "0.30            0.70            0.99991 <== BEST\n",
            "0.35            0.65            0.99992 <== BEST\n",
            "0.40            0.60            0.99992 <== BEST\n",
            "0.45            0.55            0.99992\n",
            "0.50            0.50            0.99992 <== BEST\n",
            "0.55            0.45            0.99993 <== BEST\n",
            "0.60            0.40            0.99993 <== BEST\n",
            "0.65            0.35            0.99992\n",
            "0.70            0.30            0.99993 <== BEST\n",
            "0.75            0.25            0.99993\n",
